PORT=3000

GEMINI_API_KEY=
# live = call Gemini (uses API quota), mock = offline keyword parser (no API calls)
GEMINI_MODE=mock
# optional; defaults to gemini-2.5-flash
GEMINI_MODEL=
# on (default) = if Gemini fails, that one message uses the offline parser; off = it becomes UNKNOWN
GEMINI_FALLBACK=on

LINQ_API_KEY=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
# whsec_... signing secret, shown ONCE when you create the webhook subscription
LINQ_WEBHOOK_SECRET=
# id of that subscription; used by scripts/linq-webhook.ts to switch it on/off
LINQ_WEBHOOK_SUBSCRIPTION_ID=
# Our Linq number in E.164, e.g. +12025551234. Needed only for startConversation (proactive alerts).
LINQ_FROM_NUMBER=

ZIP_API_KEY=
ZIP_API_URL=https://staging-api.zip.com
